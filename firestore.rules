rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous sign-ins (used by the Noor app in the same project) are never accepted for accounts here.
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function approvedVendor(uid) { return exists(/databases/$(database)/documents/vendors/$(uid)) && get(/databases/$(database)/documents/vendors/$(uid)).data.status == 'approved'; }

    function okVendor(d) {
      return d.keys().hasOnly(['name','city','about','type','shopUrl','whatsapp','phone','contactEmail','delivery','address','map','verified','status','updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.city is string && d.city.size() <= 60
        && d.about is string && d.about.size() <= 500
        && d.type in ['shop','direct']
        && d.shopUrl is string && d.shopUrl.size() <= 300
        && d.whatsapp is string && d.whatsapp.size() <= 20
        && d.phone is string && d.phone.size() <= 30
        && d.contactEmail is string && d.contactEmail.size() <= 120
        && d.get('delivery', '') is string && d.get('delivery', '').size() <= 200
        && d.get('address', '') is string && d.get('address', '').size() <= 200
        && d.get('map', '') is string && d.get('map', '').size() <= 500;
    }
    function okProduct(d) {
      return d.keys().hasOnly(['vendorId','name','cat','price','desc','img','imgs','buy','hidden','soldOut','updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.cat is string && d.cat.size() >= 1 && d.cat.size() <= 40
        && d.price is number && d.price >= 0 && d.price < 10000000
        && d.desc is string && d.desc.size() <= 500
        && d.img is string && d.img.size() <= 140000
        && d.get('imgs', []) is list && d.get('imgs', []).size() <= 3
        && (d.get('imgs', []).size() < 1 || d.get('imgs', [])[0].size() <= 140000)
        && (d.get('imgs', []).size() < 2 || d.get('imgs', [])[1].size() <= 140000)
        && (d.get('imgs', []).size() < 3 || d.get('imgs', [])[2].size() <= 140000)
        && d.buy is string && d.buy.size() <= 300
        && d.hidden is bool
        && d.get('soldOut', false) is bool;
    }
    function okOrder(d) {
      return d.keys().hasOnly(['vendorId','vendorName','buyerName','buyerPhone','buyerAddress','note','items','total','code','discount','offerTitle','status','createdAt'])
        && d.vendorId is string && d.vendorId.size() > 0 && d.vendorId.size() <= 128
        && d.vendorName is string && d.vendorName.size() <= 80
        && d.buyerName is string && d.buyerName.size() >= 2 && d.buyerName.size() <= 80
        && d.buyerPhone is string && d.buyerPhone.size() >= 8 && d.buyerPhone.size() <= 20
        && d.buyerAddress is string && d.buyerAddress.size() >= 5 && d.buyerAddress.size() <= 300
        && d.note is string && d.note.size() <= 300
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 20
        && d.total is number && d.total >= 0 && d.total < 100000000
        && d.status == 'new'
        && (('code' in d) == ('discount' in d))
        && d.get('offerTitle', '') is string && d.get('offerTitle', '').size() <= 80
        && (!('code' in d) || okOrderCode(d))
        && d.createdAt == request.time;
    }
    // An offer code on an order: the code must exist, be unused, belong to this vendor, be less than 7 days old, and the discount may not be larger than the offer allows.
    function okOrderCode(d) {
      let rp = /databases/$(database)/documents/redemptions/$(d.code);
      let r = get(rp).data;
      let o = get(/databases/$(database)/documents/offers/$(r.offerId)).data;
      return d.code is string && d.code.matches('^[A-HJ-KM-NP-Z2-9]{8}$')
        && r.status == 'issued' && r.vendorId == d.vendorId
        && request.time < r.createdAt + duration.value(7, 'd')
        && o.status == 'approved' && o.vendorId == d.vendorId && o.get('channel', 'both') in ['cart','both']
        && d.discount is number && d.discount > 0 && d.discount <= d.total
        && ((o.get('kind', 'other') == 'percent' && d.discount <= d.total * o.value / 100 + 1)
         || (o.get('kind', 'other') == 'flat' && d.discount <= o.value));
    }
    function okLead(d) {
      return d.keys().hasOnly(['kind','name','city','phone','email','slot','message','status','createdAt'])
        && d.kind in ['dargah','advertise','contact']
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.city is string && d.city.size() <= 60
        && d.phone is string && d.phone.size() <= 30
        && d.email is string && d.email.size() <= 120
        && d.slot is string && d.slot.size() <= 40
        && d.message is string && d.message.size() <= 1000
        && d.status == 'new'
        && d.createdAt == request.time;
    }
    function okReport(d) {
      return d.keys().hasOnly(['targetType','targetId','targetName','reason','details','contact','status','createdAt'])
        && d.targetType in ['p','v','d','o']
        && d.targetId is string && d.targetId.size() <= 60
        && d.targetName is string && d.targetName.size() <= 120
        && d.reason is string && d.reason.size() <= 60
        && d.details is string && d.details.size() >= 5 && d.details.size() <= 1000
        && d.contact is string && d.contact.size() <= 120
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    function okClaim(d) {
      return d.keys().hasOnly(['uid','email','targetType','targetId','targetName','name','phone','message','status','createdAt'])
        && d.uid == request.auth.uid
        && d.targetType in ['d','v']
        && d.targetId is string && d.targetId.size() > 0 && d.targetId.size() <= 120
        && d.targetName is string && d.targetName.size() <= 120
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 30
        && d.message is string && d.message.size() <= 1000
        && d.email is string && d.email.size() <= 120
        && d.status == 'new'
        && d.createdAt == request.time;
    }
    function okOffer(d) {
      return d.keys().hasOnly(['vendorId','title','details','discount','week','kind','value','channel','status','createdAt'])
        && d.vendorId is string
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.details is string && d.details.size() <= 300
        && d.discount is string && d.discount.size() <= 40
        && d.week is string && d.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.get('kind', 'other') in ['percent','flat','other']
        && d.get('channel', 'both') in ['shop','cart','both']
        && d.get('value', 0) is number && d.get('value', 0) >= 0 && d.get('value', 0) <= 100000
        && (d.get('kind', 'other') != 'percent' || d.get('value', 0) <= 90)
        && d.status in ['pending','approved','rejected'];
    }
    function okRedemption(d) {
      return d.keys().hasOnly(['offerId','vendorId','week','status','createdAt'])
        && d.offerId is string && d.offerId.size() > 0 && d.offerId.size() <= 40
        && d.vendorId is string && d.vendorId.size() > 0 && d.vendorId.size() <= 128
        && d.week is string && d.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.status == 'issued' && d.createdAt == request.time
        && get(/databases/$(database)/documents/offers/$(d.offerId)).data.status == 'approved'
        && get(/databases/$(database)/documents/offers/$(d.offerId)).data.vendorId == d.vendorId
        && get(/databases/$(database)/documents/offers/$(d.offerId)).data.week == d.week;
    }
    function okOwnerEdit(d) {
      return d.get('about', '').size() <= 3000 && d.get('tagline', '').size() <= 120 && d.get('address', '').size() <= 200
        && d.get('phone', '').size() <= 30 && d.get('whatsapp', '').size() <= 20 && d.get('email', '').size() <= 120
        && d.get('website', '').size() <= 300 && d.get('map', '').size() <= 500
        && d.get('timings', []).size() <= 10 && d.get('events', []).size() <= 12;
    }

    // Admins are added by hand in the Firebase console (a document whose id is the admin's user id).
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /vendors/{uid} {
      allow read: if resource.data.status == 'approved' || (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending' && !('verified' in request.resource.data) && okVendor(request.resource.data)) || isAdmin();
      allow update: if (signedIn() && request.auth.uid == uid && request.resource.data.status == resource.data.status && request.resource.data.get('verified', false) == resource.data.get('verified', false) && okVendor(request.resource.data)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow create: if (signedIn() && request.resource.data.vendorId == request.auth.uid && approvedVendor(request.auth.uid) && okProduct(request.resource.data)) || isAdmin();
      allow update: if (signedIn() && resource.data.vendorId == request.auth.uid && request.resource.data.vendorId == request.auth.uid && approvedVendor(request.auth.uid) && okProduct(request.resource.data)) || isAdmin();
      allow delete: if (signedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
    }

    // Order requests. Buyers do not sign in. An order is read by its long random id (the buyer keeps the link);
    // listing orders is only possible for the vendor it belongs to, and for admins.
    match /orders/{id} {
      allow get: if true;
      allow list: if signedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
      allow create: if okOrder(request.resource.data) && approvedVendor(request.resource.data.vendorId);
      allow update: if signedIn() && (resource.data.vendorId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','vendorNote','updatedAt'])
        && request.resource.data.status in ['new','confirmed','shipped','delivered','cancelled']
        && request.resource.data.get('vendorNote', '') is string && request.resource.data.get('vendorNote', '').size() <= 300;
      allow delete: if isAdmin();
    }

    // Requests from the public forms (list a dargah, advertise, contact) and reports. Anyone may send; only admins read.
    match /leads/{id} {
      allow create: if okLead(request.resource.data);
      allow read, update, delete: if isAdmin();
    }
    match /reports/{id} {
      allow create: if okReport(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Dargah pages. Admins import and manage them. After a claim is approved the keeper (ownerUid) may edit the descriptive fields only.
    match /dargahs/{id} {
      allow read: if resource.data.hidden == false || isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tagline','about','address','phone','whatsapp','email','website','map','lat','lon','timings','events','confirmed','lastVerified','updatedAt'])
        && okOwnerEdit(request.resource.data));
    }

    // Moon sighting: one document, settings/hijri, with a whole number of days (-2 to 2). Everyone can read it; only an admin can change it.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'hijri' && request.resource.data.keys().hasOnly(['offset', 'updatedAt', 'auto'])
        && request.resource.data.auto is bool && request.resource.data.offset is int && request.resource.data.offset >= -2 && request.resource.data.offset <= 2;
    }

    // Weekly offers (Thursday to Thursday). A vendor posts an offer, an admin approves it, then it is public.
    match /offers/{id} {
      allow read: if resource.data.status == 'approved' || (signedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
      allow create: if (signedIn() && request.resource.data.vendorId == request.auth.uid && approvedVendor(request.auth.uid)
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && okOffer(request.resource.data)) || isAdmin();
      allow update: if (signedIn() && resource.data.vendorId == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.vendorId == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == resource.data.createdAt && okOffer(request.resource.data)) || isAdmin();
      allow delete: if (signedIn() && resource.data.vendorId == request.auth.uid) || isAdmin();
    }

    // Offer codes. A customer gets a one-time code for an approved offer (no account needed). The code is the document id, so a code
    // cannot be created twice. Anyone holding the code can look it up; only the offer's vendor (or an admin) can list them or mark one used.
    match /redemptions/{code} {
      allow get: if true;
      allow list: if signedIn() && (resource.data.vendorId == request.auth.uid || isAdmin());
      allow create: if code.matches('^[A-HJ-KM-NP-Z2-9]{8}$') && okRedemption(request.resource.data);
      allow update: if signedIn() && (resource.data.vendorId == request.auth.uid || isAdmin()) && resource.data.status == 'issued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','redeemedAt']) && request.resource.data.status == 'redeemed';
      allow delete: if isAdmin();
    }

    // Claims: a signed-in keeper or shop owner asks to take over a page the Hub team listed.
    match /claims/{id} {
      allow create: if signedIn() && okClaim(request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
